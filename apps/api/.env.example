# อ้างอิง NFR-02 (Security), ADR-0003 (Multi-tenant & Auth)

DATABASE_URL="postgresql://medrota:medrota@localhost:5432/medrota_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# INT-03/04/05: OAuth2.0 SSO — ค่าจริงต้องขอจากผู้ดูแล Google/Microsoft/Facebook ของโรงพยาบาล
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ADR-0002: Python AI service base URL (ใช้เฉพาะ Conflict Check แบบ Synchronous)
AI_SERVICE_BASE_URL="http://localhost:8000"

# MVP 2 Sprint 5 (ADR-0002): ชื่อ Queue ที่ AiJobModule ส่งงานเข้า Redis/BullMQ — ต้องตรงกับ
# AI_JOB_QUEUE_NAME ฝั่ง services/ai (app/worker.py) เป๊ะ ๆ
AI_JOB_QUEUE_NAME="ai-jobs"

# INT-07: Notification Gateway — รอระบุ Provider จริง (Twilio/DTAC/True)
SMS_GATEWAY_PROVIDER=""
SMS_GATEWAY_API_KEY=""

PORT=4000
NODE_ENV="development"

# Sprint 0 bootstrap seed (prisma/seed.ts) — สร้าง Hospital + SuperAdmin ชุดแรกเท่านั้น
SEED_HOSPITAL_NAME="โรงพยาบาลตัวอย่าง (Demo Hospital)"
SEED_SUPERADMIN_EMPLOYEE_CODE="SA0001"
SEED_SUPERADMIN_EMAIL="superadmin@example.com"
SEED_SUPERADMIN_PASSWORD="ChangeMe123"
SEED_SUPERADMIN_FULLNAME="ผู้ดูแลระบบสูงสุด"
