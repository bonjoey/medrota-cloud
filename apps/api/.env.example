# อ้างอิง NFR-02 (Security), ADR-0003 (Multi-tenant & Auth)

DATABASE_URL="postgresql://medrota:medrota@localhost:5432/medrota_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# INT-03/04/05: OAuth2.0 SSO — ค่าจริงต้องขอจากผู้ดูแล Google/Microsoft/Facebook ของโรงพยาบาล
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ADR-0002: Python AI service base URL
AI_SERVICE_BASE_URL="http://localhost:8000"

# INT-07: Notification Gateway — รอระบุ Provider จริง (Twilio/DTAC/True)
SMS_GATEWAY_PROVIDER=""
SMS_GATEWAY_API_KEY=""

PORT=4000
NODE_ENV="development"
