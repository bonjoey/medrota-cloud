# ADR-0002 + MVP 2 Sprint 5: Queue (Redis/BullMQ) ที่ใช้ร่วมกับ NestJS (apps/api)
# ในการรันผ่าน docker-compose ต้องใช้ hostname "redis" (ชื่อ service) ไม่ใช่ localhost
REDIS_URL="redis://localhost:6379"

# ชื่อ Queue ต้องตรงกับที่ NestJS (AiJob module) ใช้ตอน queue.add() เป๊ะ ๆ
AI_JOB_QUEUE_NAME="ai-jobs"

# จำนวน Job ที่ app/worker.py ประมวลผลพร้อมกันได้ในแต่ละ process
AI_WORKER_CONCURRENCY="2"
